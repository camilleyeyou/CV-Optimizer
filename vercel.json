{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "installCommand": "npm install && cd server && npm install && cd ../client && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(dashboard|builder|ats-checker|ai-creator|cover-letter|tracker|interview-prep|emails|analytics|account|forgot-password|reset-password)",
      "destination": "/index.html"
    },
    {
      "source": "/(builder|share|dev)/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 9 */3 * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{server/src/fonts/**,template-registry.json}"
    }
  }
}
