{
  "name": "cv-optimizer",
  "version": "1.0.0",
  "description": "A full-stack web application for creating ATS-optimized resumes with AI-powered suggestions and professional PDF export.",
  "main": "index.js",
  "scripts": {
    "build": "cd client && npm run build",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm start",
    "dev:server": "cd server && npm run dev",
    "start": "npm run dev",
    "test": "cd server && npx jest",
    "verify:parity": "node scripts/verify-preview-parity.mjs && python3 scripts/preview-parity-report.py",
    "validate:templates": "node scripts/validate-templates.mjs",
    "verify:seo": "node scripts/verify-seo.mjs",
    "previews:generate": "node scripts/generate-template-previews.mjs",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camilleyeyou/CV-Optimizer.git"
  },
  "keywords": [
    "resume",
    "cv",
    "ats",
    "resume-builder",
    "cover-letter",
    "ai",
    "openai",
    "job-search"
  ],
  "author": "camilleyeyou (https://github.com/camilleyeyou)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/camilleyeyou/CV-Optimizer/issues"
  },
  "homepage": "https://github.com/camilleyeyou/CV-Optimizer#readme",
  "comments": {
    "dependencies": "Runtime deps for the API live in server/package.json — Vercel installs them via `cd server && npm install`, and api/index.js only requires ../server/src/server. The root holds only the tooling needed to orchestrate the dev/test scripts."
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
