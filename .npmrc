# rate-limit-redis@5 declares a peer of express-rate-limit >= 8.5.0, but the
# server package pins ^6. The Upstash/redis store is lazy-loaded only when
# Upstash is configured (and falls back to Supabase otherwise), so the version
# skew is never exercised at runtime. Relax peer resolution so installs succeed
# locally and on Vercel. npm reads this from parent dirs, covering server/ and
# client/ installs too.
legacy-peer-deps=true
