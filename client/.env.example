# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API — leave blank; Vite proxy handles localhost in dev, empty in prod
VITE_API_URL=

# Premium-template paywall. Leave unset/false until billing is live so every
# template is selectable; set to 'true' to lock premium templates in the picker.
# Must match the server's TEMPLATE_PAYWALL_ENABLED.
VITE_TEMPLATE_PAYWALL_ENABLED=false

# Canonical site origin for SEO/OG links (optional; defaults to the vercel.app URL)
VITE_SITE_URL=

# Google OAuth web client ID (optional). Public by design — it ships in the
# bundle. When set, Google sign-in runs in-page via Identity Services, so the
# consent screen names this app instead of the Supabase project host. When
# unset, or wherever Identity Services is blocked, sign-in falls back to the
# redirect flow on its own. The same client ID must be listed under the Google
# provider in Supabase, and this app's origins must be Authorized JavaScript
# origins on the client in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
