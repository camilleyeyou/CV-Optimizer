# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API — leave blank; Vite proxy handles localhost in dev, empty in prod
VITE_API_URL=

# Premium-template paywall. Leave unset/false until billing is live so every
# template is selectable; set to 'true' to lock premium templates in the picker.
# Must match the server's TEMPLATE_PAYWALL_ENABLED.
VITE_TEMPLATE_PAYWALL_ENABLED=false

# Canonical site origin for SEO/OG links (optional; defaults to the vercel.app URL)
VITE_SITE_URL=
