{
  "_comment": "Single source of truth for resume templates AND the shared layout contract. page/fonts/layout/typography/spacing define the geometry that the server PDF renderer (server/src/templateRegistry.js) and the client preview (client/src/config/templates.js) must both obey, so the on-screen preview wraps lines and paginates identically to the exported PDF. All distances are PostScript points. fonts.metrics.<family>.lineHeightRatio is (ascender + lineGap - descender)/1000, i.e. exactly the line advance PDFKit computes, and is what the preview uses as CSS line-height. maxPages is the page budget each template must stay within for the dense stress fixture in server/__tests__/fixtures/stressResume.js. Do not hardcode any of these values in either renderer.",
  "archetypes": {
    "classic-centered": "Centered name/title header, single column, full-width section rules.",
    "classic-left": "Left-aligned header, single column, skills-forward.",
    "formal-left": "Left-aligned serif header, dense single column for academic/consulting.",
    "header-band": "Full-width colored header band with reversed-out name, single column below.",
    "sidebar": "Two-column layout with a colored sidebar carrying contact, skills and languages.",
    "compact": "Dense single column with smaller type and two-column skills to fit more content.",
    "infographic": "Single column with two-column accent skill chips and accent blocks."
  },
