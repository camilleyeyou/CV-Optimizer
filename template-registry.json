      "arabic": {
        "ascender": 1374,
        "descender": -738,
        "lineGap": 0,
        "lineHeightRatio": 2.112
      },
      "cjk": {
        "ascender": 1160,
        "descender": -288,
        "lineGap": 0,
        "lineHeightRatio": 1.448
      }
    },
    "webFormat": "woff2",
    "_note": "families list the canonical TTF/OTF files the PDF renderer embeds (PDFKit cannot subset woff2). The preview loads the same faces from webPath with the extension swapped to webFormat - a lossless re-encoding, so metrics are byte-identical and line wrapping matches."
