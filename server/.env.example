# Server
PORT=5002
NODE_ENV=development

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (required)
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI models — defaults live in server/src/config/models.js.
# Verify the EXACT model IDs available to your account in the OpenAI dashboard
# before overriding (an invalid ID makes every AI call fail).
OPENAI_MODEL_DEFAULT=gpt-5.4-mini
OPENAI_MODEL_PREMIUM=gpt-5.4

# Client URL (required in production — must NOT be localhost)
CLIENT_URL=http://localhost:3000

# Stripe (required for billing — see STRIPE_SETUP.md)
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_PRO=price_xxx_pro_monthly
STRIPE_PRICE_PREMIUM=price_xxx_premium_monthly

# Rate limiting — shared store. If Upstash is unset, falls back to a
# Supabase-backed counter (run migration 005_rate_limit.sql). Optional.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Premium-template paywall. Leave unset/false until billing is live so all
# templates download for everyone; set to 'true' to require Pro for premium
# templates. Must match the client's VITE_TEMPLATE_PAYWALL_ENABLED.
TEMPLATE_PAYWALL_ENABLED=false
