# See repo-root .npmrc. rate-limit-redis@5 peers express-rate-limit >= 8.5.0
# while this package pins ^6; the Upstash store is lazy-loaded only when
# configured (Supabase fallback otherwise), so the skew is never hit at runtime.
# Required here because npm reads .npmrc from the cwd (server/) on Vercel's
# `cd server && npm install`.
legacy-peer-deps=true
